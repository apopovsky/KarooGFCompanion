<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_gf_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/img_gf_canvas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@string/datatype_gf_pacing_name"
        android:scaleType="fitXY" />

    <!-- Touch overlay for Normal Gauge Mode (only visible in FULL_PAGE when !config.preview) -->
    <LinearLayout
        android:id="@+id/overlay_gauge_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="74" />

        <FrameLayout
            android:id="@+id/touch_next_card"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="26"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

    <!-- Touch overlay for Segment Plan Overlay Mode -->
    <LinearLayout
        android:id="@+id/overlay_segment_list_touch"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:weightSum="100"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/touch_close_overlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="12"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true" />

        <FrameLayout
            android:id="@+id/touch_overlay_body"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="88"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>

</FrameLayout>
